COPILOT_API_TOKEN=replace-with-a-long-random-token
COPILOT_PORT=8080
COPILOT_PROVIDER=dry-run
COPILOT_PROJECTS_PATH=./projects

# Required only when COPILOT_PROVIDER=http.
# Use localhost for separate host processes, or an authenticated HTTPS service for Compose.
COPILOT_MODEL_GATEWAY_URL=https://model-gateway.internal.example/v1/conference
COPILOT_MODEL_GATEWAY_API_KEY=replace-with-a-different-long-random-token

# Used by the separately operated reference model gateway.
COPILOT_MODEL_BACKEND_URL=https://provider.example/v1/chat/completions
COPILOT_MODEL_BACKEND_API_KEY=replace-with-provider-secret
COPILOT_MODEL_STANDARD=replace-with-standard-model-id
COPILOT_MODEL_DEEP=replace-with-deep-model-id
COPILOT_MODEL_MAXIMUM=replace-with-maximum-model-id
