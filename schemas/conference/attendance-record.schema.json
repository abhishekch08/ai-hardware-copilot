{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent attendance and relevance decision",
  "type": "object",
  "required": ["agent_id", "proposal_version", "relevance", "score", "mandatory", "reasons"],
  "properties": {
    "agent_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2}$"},
    "proposal_version": {"type": "integer", "minimum": 1},
    "relevance": {"enum": ["primary", "reviewer", "affected", "monitor", "out_of_scope"]},
    "score": {"type": "number", "minimum": 0},
    "mandatory": {"type": "boolean"},
    "reasons": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "interfaces_affected": {"type": "array", "items": {"type": "string"}},
    "model_metadata": {"type": "object"}
  },
  "additionalProperties": false
}
