{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross-domain synthesis for the next proposal version",
  "type": "object",
  "required": ["proposal_version", "round_number", "rationale"],
  "properties": {
    "proposal_version": {"type": "integer", "minimum": 1},
    "round_number": {"type": "integer", "minimum": 1},
    "rationale": {"type": "string"},
    "proposal_changes": {"type": "object"},
    "changed_interfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "addressed_objection_ids": {"type": "array", "items": {"type": "string"}},
    "unresolved_objection_ids": {"type": "array", "items": {"type": "string"}},
    "model_metadata": {"type": "object"}
  },
  "additionalProperties": false
}
