{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-updated diagnostic session",
  "type": "object",
  "required": ["session_id", "hypotheses", "experiments", "steps", "status"],
  "properties": {
    "session_id": {"type": "string", "minLength": 1},
    "hypotheses": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["hypothesis_id", "mechanism", "probability", "status"],
        "properties": {
          "hypothesis_id": {"type": "string", "minLength": 1},
          "mechanism": {"type": "string", "minLength": 1},
          "probability": {"type": "number", "minimum": 0, "maximum": 1},
          "status": {"enum": ["open", "confirmed_candidate", "rejected"]}
        },
        "additionalProperties": false
      }
    },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["experiment_id", "question", "outcomes", "likelihoods", "time_cost", "risk_cost", "monetary_cost"],
        "properties": {
          "experiment_id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "outcomes": {"type": "array", "minItems": 2, "items": {"type": "string"}, "uniqueItems": true},
          "likelihoods": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object"}},
          "time_cost": {"type": "number", "minimum": 0},
          "risk_cost": {"type": "number", "minimum": 0},
          "monetary_cost": {"type": "number", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["experiment_id", "expected_information_gain_bits", "utility", "observed_outcome", "evidence_ref", "posterior"],
        "properties": {
          "experiment_id": {"type": "string", "minLength": 1},
          "expected_information_gain_bits": {"type": "number", "minimum": 0},
          "utility": {"type": "number", "minimum": 0},
          "observed_outcome": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": "string", "pattern": "^evidence://sha256/[0-9a-f]{64}$"},
          "posterior": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}}
        },
        "additionalProperties": false
      }
    },
    "status": {"enum": ["investigating", "root_cause_candidate", "blocked_step_limit"]}
  },
  "additionalProperties": false
}
