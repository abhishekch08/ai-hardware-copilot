{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Revision-aware engineering project manifest",
  "type": "object",
  "required": ["project_id", "hardware_revision", "sources"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "hardware_revision": {"type": "string", "minLength": 1},
    "firmware_revision": {"type": ["string", "null"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "path"],
        "properties": {
          "kind": {"enum": ["kicad_schematic", "kicad_pcb", "bom_csv", "firmware_tree", "document"]},
          "path": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
